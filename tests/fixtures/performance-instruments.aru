canvas 376 304
background none


group guitarra_electrica {
    at 16 16
    label "Guitarra eléctrica"
    group guitarra_inclinada {
        at 24 24
        rotate 35
        path cuerpo_doble_cutaway { move -3 3; curve -5 0 -8 -2 -9 1; curve -10 5 -8 8 -9 11; curve -11 17 -6 22 0 22; curve 6 22 11 17 9 11; curve 8 8 11 4 10 -2; curve 9 -5 5 -1 3 3; close; fill none; stroke #2F5148 2.4; cap round; join round }
        line mastil { from 0 3; to 0 -17; stroke #2F5148 2.4; cap round }
        rect pala { at 0 -21; size 6 8; corner 2.5; fill none; stroke #2F5148 2.4 }
        line clavija_1 { from 4 -24; to 5.5 -24; stroke #2F5148 2.4; cap round }
        line clavija_2 { from 4 -21; to 5.5 -21; stroke #2F5148 2.4; cap round }
        line clavija_3 { from 4 -18; to 5.5 -18; stroke #2F5148 2.4; cap round }
        line pastilla_mastil { from -3 8; to 3 8; stroke #2F5148 2.4; cap round }
        line pastilla_puente { from -3 14; to 3 14; stroke #2F5148 2.4; cap round }
    }
}
group teclado_musical {
    at 88 16
    label "Teclado musical"
    rect carcasa { at 24 24; size 40 26; corner 4; fill none; stroke #2F5148 2.4 }
    line franja_controles { from 4 19; to 44 19; stroke #2F5148 2.4; cap round }
    group controles {
        line boton { from 10 15; to 13 15; stroke #2F5148 2.4; cap round }
        line pantalla { from 28 15; to 38 15; stroke #2F5148 2.4; cap round }
    }
    group teclas_negras {
        line negra_1 { from 12 19; to 12 28; stroke #2F5148 2.4; cap round }
        line negra_2 { from 18 19; to 18 28; stroke #2F5148 2.4; cap round }
        line negra_3 { from 28 19; to 28 28; stroke #2F5148 2.4; cap round }
        line negra_4 { from 33.5 19; to 33.5 28; stroke #2F5148 2.4; cap round }
        line negra_5 { from 39 19; to 39 28; stroke #2F5148 2.4; cap round }
    }
    group divisiones_blancas {
        line division_1 { from 15 32; to 15 37; stroke #2F5148 2.4; cap round }
        line division_2 { from 23 32; to 23 37; stroke #2F5148 2.4; cap round }
        line division_3 { from 31 32; to 31 37; stroke #2F5148 2.4; cap round }
    }
}
group maracas {
    at 160 16
    label "Maracas"
    group maraca_izquierda {
        at 15 26
        rotate -20
        ellipse cabeza { at 0 -8; size 14 18; fill none; stroke #2F5148 2.4 }
        path mango { move -3 0.5; curve -2 3 -2 4 -2 6; line -2 14; quad 0 16.5 2 14; line 2 6; curve 2 4 2 3 3 0.5; fill none; stroke #2F5148 2.4; cap round; join round }
    }
    group maraca_derecha {
        at 33 26
        rotate 20
        ellipse cabeza { at 0 -8; size 14 18; fill none; stroke #2F5148 2.4 }
        path mango { move -3 0.5; curve -2 3 -2 4 -2 6; line -2 14; quad 0 16.5 2 14; line 2 6; curve 2 4 2 3 3 0.5; fill none; stroke #2F5148 2.4; cap round; join round }
    }
}
group bateria_acustica {
    at 232 16
    label "Batería acústica"
    group bombo {
        circle parche_bombo { at 24 31; radius 11; fill none; stroke #2F5148 2.4 }
        circle aro_bombo { at 24 31; radius 5.5; fill none; stroke #2F5148 2.4 }
    }
    group tom_izquierdo {
        at 17 15
        rotate -15
        ellipse cuerpo_tom { size 10 7; fill none; stroke #2F5148 2.4 }
    }
    group tom_derecho {
        at 31 15
        rotate 15
        ellipse cuerpo_tom { size 10 7; fill none; stroke #2F5148 2.4 }
    }
    group platillo {
        line varilla { from 8 9; to 8 30; stroke #2F5148 2.4; cap round }
        group plato {
            at 8 8
            rotate -12
            ellipse disco { size 8 2.5; fill none; stroke #2F5148 2.4 }
        }
    }
}
group violin {
    at 304 16
    label "Violín"
    path caja { move 24 19; curve 28 19 31 20 31 24; curve 31 27 28.5 28 28.5 31; curve 28.5 34 34 35 34 39; curve 34 43 29 44 24 44; curve 19 44 14 43 14 39; curve 14 35 19.5 34 19.5 31; curve 19.5 28 17 27 17 24; curve 17 20 20 19 24 19; close; fill none; stroke #2F5148 2.4; cap round; join round }
    path diapason { move 24 10; line 24 36; fill none; stroke #2F5148 2.4; cap round; join round }
    path voluta { move 24 10; line 24 7; curve 24 3.5 29 3.5 29 6.5; curve 29 9 25.5 9 26 6.5; fill none; stroke #2F5148 2.4; cap round; join round }
    path efe_izquierda { move 19 34; quad 21 36 19 39; fill none; stroke #2F5148 2.4; cap round; join round }
    path efe_derecha { move 29 34; quad 27 36 29 39; fill none; stroke #2F5148 2.4; cap round; join round }
}
group violonchelo {
    at 16 88
    label "Violonchelo"
    path caja { move 24 15; curve 29 15 33 18 33 21; curve 33 24 29.5 25 29.5 28; curve 29.5 30 35 31 35 35; curve 35 39 30 40 24 40; curve 18 40 13 39 13 35; curve 13 31 18.5 30 18.5 28; curve 18.5 25 15 24 15 21; curve 15 18 19 15 24 15; close; fill none; stroke #2F5148 2.4; cap round; join round }
    path diapason { move 24 9; line 24 33; fill none; stroke #2F5148 2.4; cap round; join round }
    path voluta { move 24 9; line 24 6.5; curve 24 3 29 3 29 6; curve 29 8.5 25.5 8.5 26 6; fill none; stroke #2F5148 2.4; cap round; join round }
    path efe_izquierda { move 18.5 31; quad 20.5 33 18.5 36; fill none; stroke #2F5148 2.4; cap round; join round }
    path efe_derecha { move 29.5 31; quad 27.5 33 29.5 36; fill none; stroke #2F5148 2.4; cap round; join round }
    path pica { move 24 40; line 24 46; fill none; stroke #2F5148 2.4; cap round; join round }
}
group arpa {
    at 88 88
    label "Arpa"
    line columna { from 10 9; to 10 42; stroke #2F5148 2.4; cap round }
    path cuello { move 10 8; curve 16 6 20 15 27 14; curve 33 13 35 8 38 7; fill none; stroke #2F5148 2.4; cap round; join round }
    path caja { move 38 7; line 13 42; line 22 42; line 39 11; fill none; stroke #2F5148 2.4; cap round; join round }
    line base { from 7 42; to 22 42; stroke #2F5148 2.4; cap round }
    line cuerda1 { from 16 11; to 16 35; stroke #2F5148 2.4; cap round }
    line cuerda2 { from 22 14; to 22 27; stroke #2F5148 2.4; cap round }
    line cuerda3 { from 28 15; to 28 20; stroke #2F5148 2.4; cap round }
}
group acordeon {
    at 160 88
    label "Acordeón"
    group teclado {
        label "Teclado"
        rect caja { at 10 24; size 10 30; corner 2.5; fill none; stroke #2F5148 2.4; join round }
        line tecla1 { from 7 17; to 11 17; stroke #2F5148 2.4; cap round }
        line tecla2 { from 7 24; to 11 24; stroke #2F5148 2.4; cap round }
        line tecla3 { from 7 31; to 11 31; stroke #2F5148 2.4; cap round }
    }
    group fuelle {
        label "Fuelle"
        path zigzagSup { move 15 11; line 18.5 8; line 22 11; line 25.5 8; line 29 11; line 32 9; fill none; stroke #2F5148 2.4; cap round; join round }
        path zigzagInf { move 15 37; line 18.5 40; line 22 37; line 25.5 40; line 29 37; line 32 39; fill none; stroke #2F5148 2.4; cap round; join round }
        line pliegue1 { from 22 13; to 22 35; stroke #2F5148 2.4; cap round }
        line pliegue2 { from 29 13; to 29 35; stroke #2F5148 2.4; cap round }
    }
    group bajos {
        label "Panel de bajos"
        rect caja { at 37 24; size 10 30; corner 2.5; fill none; stroke #2F5148 2.4; join round }
        circle b1 { at 37 16; radius 1.2; fill none; stroke #2F5148 2.4 }
        circle b2 { at 37 24; radius 1.2; fill none; stroke #2F5148 2.4 }
        circle b3 { at 37 32; radius 1.2; fill none; stroke #2F5148 2.4 }
    }
}
group trompeta {
    at 232 88
    label "Trompeta"
    group campana {
        label "Campana"
        path campana_cono { move 5 12; quad 10 19 20 20; line 20 22; quad 10 23 5 30; close; fill none; stroke #2F5148 2.4; cap round; join round }
    }
    group tubo {
        label "Tubo principal"
        line tubo_recto { from 20 21; to 40 21; stroke #2F5148 2.4; cap round }
    }
    group lazo {
        label "Lazo en U"
        rect lazo_u { at 30 30; size 22 8; corner 4; fill none; stroke #2F5148 2.4 }
    }
    group pistones {
        label "Pistones"
        line piston_1 { from 26 15; to 26 30; stroke #2F5148 2.4; cap round }
        line piston_2 { from 30 15; to 30 30; stroke #2F5148 2.4; cap round }
        line piston_3 { from 34 15; to 34 30; stroke #2F5148 2.4; cap round }
        circle boton_1 { at 26 12; radius 1.4; fill none; stroke #2F5148 2.4 }
        circle boton_2 { at 30 12; radius 1.4; fill none; stroke #2F5148 2.4 }
        circle boton_3 { at 34 12; radius 1.4; fill none; stroke #2F5148 2.4 }
    }
    group boquilla {
        label "Boquilla"
        line boquilla_tubo { from 40 21; to 43 21; stroke #2F5148 2.4; cap round }
        line boquilla_copa { from 44 18.5; to 44 23.5; stroke #2F5148 2.4; cap round }
    }
}
group saxofon {
    at 304 88
    label "Saxofón"
    group cuerpo {
        label "Cuerpo en J"
        path cuerpo_j { move 21 12; line 18 36; curve 18 45 34 45 34 34; line 37 23; line 29 23; line 29 34; quad 29 38 26 38; quad 23 38 23 34; line 26 12; close; fill none; stroke #2F5148 2.4; cap round; join round }
    }
    group campana {
        label "Campana"
        ellipse campana_abertura { at 33 22; size 11 4; fill none; stroke #2F5148 2.4 }
    }
    group tudel {
        label "Tudel y boquilla"
        path tudel_curva { move 23.5 12; quad 22 5 15 5; fill none; stroke #2F5148 2.4; cap round; join round }
        line boquilla { from 15 5; to 10 7; stroke #2F5148 2.4; cap round }
    }
    group llaves {
        label "Llaves"
        circle llave_1 { at 22.5 19; radius 0.5; fill none; stroke #2F5148 2.4 }
        circle llave_2 { at 22 25; radius 0.5; fill none; stroke #2F5148 2.4 }
        circle llave_3 { at 21.5 31; radius 0.5; fill none; stroke #2F5148 2.4 }
    }
}
group trombon {
    at 16 160
    label "Trombón"
    group vara {
        label "Vara"
        path vara_u { move 14 30; line 40 30; quad 44 30 44 33; quad 44 36 40 36; line 14 36; fill none; stroke #2F5148 2.4; cap round; join round }
        line travesano { from 22 30; to 22 36; stroke #2F5148 2.4; cap round }
    }
    group seccion_campana {
        label "Sección de campana"
        path curva_u { move 24 16; line 10 16; quad 5 16 5 21; quad 5 26 10 26; line 14 26; line 14 30; fill none; stroke #2F5148 2.4; cap round; join round }
    }
    group campana {
        label "Campana"
        path campana_cono { move 24 14; quad 34 13 42 6; line 42 24; quad 34 19 24 18; close; fill none; stroke #2F5148 2.4; cap round; join round }
    }
    group boquilla {
        label "Boquilla"
        line boquilla_tubo { from 14 36; to 7 36; stroke #2F5148 2.4; cap round }
        line boquilla_copa { from 5 34; to 5 38; stroke #2F5148 2.4; cap round }
    }
}
group clarinete {
    at 88 160
    label "Clarinete"
    group clarinete_diagonal {
        at 24 24
        rotate 45
        label "Clarinete diagonal"
        path boquilla_cuna { move -19 -2.5; line -23 -1; line -23 1; line -19 2.5; fill none; stroke #2F5148 2.4; cap round; join round }
        rect barrilete { at -16 0; size 6 7; corner 2; fill none; stroke #2F5148 2.4 }
        rect cuerpo { size 26 5; corner 2.5; fill none; stroke #2F5148 2.4 }
        line anillo_union { from -1 -2.5; to -1 2.5; stroke #2F5148 2.4; cap round }
        path campana { move 13 -2.5; quad 17 -3 20 -5; line 20 5; quad 17 3 13 2.5; fill none; stroke #2F5148 2.4; cap round; join round }
    }
}
