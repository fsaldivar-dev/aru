// Halloween — luna, murciélagos, telarañas y calabazas (ARU)
canvas 1500 2100
background #160C26
gradient night linear 90 { stop 0 #120A20; stop 0.6 #2A1340; stop 1 #3A1A3F }
gradient moonGlow radial 0.5 0.5 0.5 { stop 0 #FFB347 0.5; stop 0.5 #FF8C2B 0.16; stop 1 #FF8C2B 0 }
gradient moonFace radial 0.4 0.35 0.7 { stop 0 #FFF0C4; stop 1 #F0C065 }
gradient pumpkinG radial 0.4 0.35 0.75 { stop 0 #FFA238; stop 1 #D9631A }
gradient clear radial 0.5 0.5 0.5 {
    stop 0 #1D0F31 0.85
    stop 0.6 #1D0F31 0.55
    stop 1 #1D0F31 0
}
rect base { at 750 1050; size 1500 2100; fill night; layer background }

define bat {
    path wingR { move 4 -4; curve 20 -18 44 -26 62 -18; quad 54 -6 48 4; quad 40 -4 32 6; quad 24 -2 16 8; quad 10 2 4 6; close }
    clone wingR wingL { scale -1 1 }
    ellipse body { at 0 2; size 14 22 }
    circle head { at 0 -10; radius 6 }
    polygon ears { points -5 -13 -4 -21 -1 -15 1 -15 4 -21 5 -13 }
}
define pumpkin {
    ellipse { at -34 0; size 70 90; fill pumpkinG }
    ellipse { at 34 0; size 70 90; fill pumpkinG }
    ellipse { at 0 0; size 76 96; fill pumpkinG }
    path stem { move -6 -44; quad -4 -62 8 -70; line 12 -64; quad 4 -58 6 -44; close; fill #4B6B2A }
}

group sky {
    layer far
    repeat 130 { circle { at rand(21,0,1500) rand(22,0,1500); radius rand(23,1,3); fill #FFF4D6; opacity rand(24,0.3,1) } }
    circle glow { at 1120 380; radius 430; fill moonGlow }
    circle moon { at 1120 380; radius 190; fill moonFace }
    circle { at 1060 330; radius 34; fill #E2B159; opacity 0.45 }
    circle { at 1180 450; radius 22; fill #E2B159; opacity 0.4 }
    circle { at 1150 300; radius 14; fill #E2B159; opacity 0.4 }
}
group bats {
    layer mid
    fill #0B0612
    repeat 16 { clone bat { at rand(31,80,1420) rand(32,120,900); rotate rand(33,-20,20); scale rand(34,0.6,1.6); opacity rand(35,0.8,1) } }
}
define web {
    repeat 8 k { line { from 0 0; to 540*cos(k*12.857) 540*sin(k*12.857) } }
    repeat 7 r {
        repeat 7 k {
            path { move (70+r*68)*cos(k*12.857) (70+r*68)*sin(k*12.857); quad (60+r*62)*cos(k*12.857+6.43) (60+r*62)*sin(k*12.857+6.43) (70+r*68)*cos((k+1)*12.857) (70+r*68)*sin((k+1)*12.857); fill none }
        }
    }
}
group webs {
    layer near
    stroke #D9CCE8 1.8
    opacity 0.45
    clone web { at 0 0 }
    clone web { at 1500 2100; rotate 180 }
}
group pumpkins {
    layer near
    clone pumpkin { at 210 1960; scale 1.5 }
    clone pumpkin { at 400 2010; scale 1.0 }
    clone pumpkin { at 90 2040; scale 0.8 }
}
ellipse textArea { at 750 1150; size 1100 1250; fill clear; layer near; semantic layout.textArea }
