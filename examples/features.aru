// ARU feature tour: gradients, expressions, repeat, define/clone, fur, layers, ops targets
canvas 600 400
background #1b2838

gradient sky linear 90 {
    stop 0 #ff9a5a
    stop 1 #2b3a67
}
gradient glow radial 0.5 0.5 0.6 {
    stop 0 #ffffff 0.9
    stop 1 #ffffff 0
}

rect skyBox { at 300 200; size 600 400; fill sky; layer background; semantic sky }
circle halo { at 450 120; radius 90; fill glow; layer background }
circle sun { at 450 120; radius 40; fill #ffe08a; layer background }

// a reusable leaf: `define` never renders by itself
define leaf {
    path {
        move 0 0
        curve 20 -30 60 -30 80 0
        curve 60 30 20 30 0 0
        close
        fill #4e9a4e
        stroke #2f6b2f 1.5
    }
}

group flower {
    at 150 250
    semantic plant.flower
    role foreground
    repeat 8 {
        clone leaf { rotate i*45  opacity (0.6 + t*0.4) }
    }
    circle core { radius 18; fill #f6c453; stroke #b07f1a 2 }
    fur core { density 3; length 10; width 1.5; colors [#ffd36b #e39a2c]; direction radial }
}

clone flower flower2 { at 420 300; scale 0.5; rotate 20 }

// hills with expressions + deterministic randomness (seed-based, repeatable)
repeat 12 {
    ellipse { at 25+i*50 380; size 90 rand(1,40,90); fill pick(2, #2d6b3a, #3c8a4a, #255a32); layer far; semantic plant.bush }
}
