// Sajaru Soccer — escudo circular (ARU). Misma S de la familia Sajaru + patrón de balón + texto en arco.
canvas 1200 1200
background none

define monogramS { polygon { points -45.0 -150 127.0 -150 111.5 -64 55.5 -64 60.9 -94 -27.1 -94 -39.0 -28 105.0 -28 78.0 122 45.0 150 -127.0 150 -111.5 64 -55.5 64 -60.9 94 27.1 94 39.0 28 -105.0 28 -78.0 -122 } }

group badge {
    at 600 600
    semantic brand.sajaru.soccer
    circle outer { radius 440; fill #0E0E0E }
    circle ringLine { radius 432; fill none; stroke #12A150 6 }
    circle field { radius 330; fill #12A150 }
    circle fieldEdge { radius 338; fill none; stroke #FFFFFF 10 }
    // ball pattern inside the field, faint
    group pattern {
        clip fieldClip
        circle fieldClip { radius 330; fill none }
        opacity 0.18
        polygon { points 0.0 -70.0 66.6 -21.6 41.1 56.6 -41.1 56.6 -66.6 -21.6; fill #0B5E2E }
        repeat 5 k {
            group {
                rotate k*72
                polygon { at 0 -205; points 0.0 70.0 -66.6 21.6 -41.1 -56.6 41.1 -56.6 66.6 21.6; fill #0B5E2E }
                line { from 0 -70; to 0 -140; stroke #0B5E2E 10 }
            }
        }
    }
    clone monogramS markShadow { scale 1.3; at 10 12; fill #0B5E2E; opacity 0.55 }
    clone monogramS mark { scale 1.3; fill #FFFFFF }
    text top { content "SAJARU"; font "Avenir Next Condensed"; weight 800; size 96; spacing 18; arc 386 top; fill #FFFFFF }
    text bottom { content "SOCCER"; font "Avenir Next Condensed"; weight 800; size 96; spacing 18; arc 386 bottom; fill #FFFFFF }
    polygon starL { at -386 0; points 0.0 -26.0 6.5 -8.9 24.7 -8.0 10.5 3.4 15.3 21.0 0.0 11.0 -15.3 21.0 -10.5 3.4 -24.7 -8.0 -6.5 -8.9; scale 1.1; fill #12A150 }
    polygon starR { at 386 0; points 0.0 -26.0 6.5 -8.9 24.7 -8.0 10.5 3.4 15.3 21.0 0.0 11.0 -15.3 21.0 -10.5 3.4 -24.7 -8.0 -6.5 -8.9; scale 1.1; fill #12A150 }
}
